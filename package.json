{
  "name": "mcp-spec",
  "version": "0.1.0",
  "description": "Conformance and behavior testing for MCP servers. Runs in CI, fails your build when the server drifts.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "conformance",
    "ci",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "author": "dbc1234",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbc1234/mcp-spec.git"
  },
  "bugs": {
    "url": "https://github.com/dbc1234/mcp-spec/issues"
  },
  "homepage": "https://github.com/dbc1234/mcp-spec#readme",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-spec": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "selftest": "node dist/cli.js --config examples/mcp.test.yaml",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
